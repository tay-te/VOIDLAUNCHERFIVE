{
	"schemaVersion": 1,
	"id": "mettle",
	"version": "${version}",
	"name": "VOID Mettle",
	"description": "Who you become: a background you start from, five attributes, skills that grow by doing them, perk trees that change how you play, and an inventory where everything weighs.",
	"authors": [
		"VOID"
	],
	"license": "All-Rights-Reserved",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.voidmc.mettle.Mettle"
		],
		"client": [
			"dev.voidmc.mettle.client.MettleClient"
		]
	},
	"mixins": [
		"mettle-character.mixins.json",
		"mettle-blades.mixins.json",
		"mettle-heavyweapons.mixins.json",
		"mettle-marksmanship.mixins.json",
		"mettle-defense.mixins.json",
		"mettle-athletics.mixins.json",
		"mettle-survival.mixins.json",
		"mettle-smithing.mixins.json",
		"mettle-burden.mixins.json",
		"mettle-gear.mixins.json",
		"mettle-cards.mixins.json",
		{
			"config": "mettle-character.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "mettle-blades.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "mettle-heavyweapons.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "mettle-marksmanship.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "mettle-defense.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "mettle-athletics.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "mettle-survival.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "mettle-smithing.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "mettle-burden.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "mettle-gear.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"hearth": "*",
		"expanse": "*"
	}
}