{
	"schemaVersion": 1,
	"id": "atlas",
	"version": "${version}",
	"name": "VOID Atlas",
	"description": "A beautiful world map and minimap: muted, hand-toned terrain with stepped relief, waypoints, discovered structures, an underground and a Nether layer, and an API for other mods' markers.",
	"authors": ["VOID"],
	"license": "All-Rights-Reserved",
	"icon": "assets/atlas/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.voidmc.atlas.client.AtlasClient"],
		"modmenu": ["dev.voidmc.atlas.client.compat.ModMenuCompat"]
	},
	"mixins": [{"config": "atlas.client.mixins.json", "environment": "client"}],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"expanse": "*"
	},
	"custom": {
		"atlas:api": "dev.voidmc.atlas.api.AtlasApi"
	}
}
