{
  "multipart": [
    {
      "apply": {
        "model": "expanse:block/saguaro_core"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "expanse:block/saguaro_up"
      }
    },
    {
      "when": {
        "up": "false"
      },
      "apply": {
        "model": "expanse:block/saguaro_cap"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "expanse:block/saguaro_down"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "expanse:block/saguaro_arm"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "expanse:block/saguaro_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "expanse:block/saguaro_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "expanse:block/saguaro_arm",
        "y": 270
      }
    }
  ]
}
