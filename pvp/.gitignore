# ---- Rust -------------------------------------------------------------------
target/
**/target/
*.rs.bk
Cargo.lock.orig

# ---- Node / pnpm ------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*

# Build output of packages/ingame, copied into the mod JAR by Gradle.
# Generated on every build; never committed.
mod/src/main/resources/assets/void/ui/*
!mod/src/main/resources/assets/void/ui/README.md

# Build output of packages/ui: the gallery bundle and the font-build scratch dir.
# The gallery is a development surface and is never shipped; the woff2 files it is
# built from are committed under packages/ui/src/fonts/.
packages/ui/gallery-dist/
packages/ui/.font-build/

# ---- Gradle / Java ----------------------------------------------------------
.gradle/
**/build/
!**/src/**/build/
out/
*.class
*.jar
# The negation must be a full-path glob: a bare `gradle/...` pattern is resolved
# relative to this file (pvp/), so it never matched pvp/mod/gradle/wrapper/.
!**/gradle/wrapper/gradle-wrapper.jar
run/

# ---- CMake / native ---------------------------------------------------------
mod/native/build/
mod/native/cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
*.o
*.obj
*.so
*.dylib
*.dll
*.pdb
*.lib
*.a

# ---- Ultralight SDK downloads -----------------------------------------------
# The SDK ships as a .7z; it is fetched by CI, never committed (~25 MB of natives).
*.7z
mod/native/sdk/
mod/native/third_party/ultralight/

# ---- Tauri ------------------------------------------------------------------
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# ---- Editors / OS -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Visual QA (agent output) -----------------------------------------------
# Screenshots, diffs and working images from the visual QA pass. Only the report
# and one final side-by-side per screen are tracked.
packages/ingame/visual-qa/*
!packages/ingame/visual-qa/report.md
!packages/ingame/visual-qa/final/
packages/ingame/visual-qa/final/*
!packages/ingame/visual-qa/final/*.png
