{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VOID PVP",
  "version": "0.1.0",
  "identifier": "dev.void.pvp",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "VOID PVP",
        "width": 1300,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": false,
        "backgroundColor": "#0a0b0c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https://crafatar.com https://mc-heads.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Game",
    "shortDescription": "VOID PVP — a Minecraft 1.8.9 PVP client",
    "longDescription": "The VOID PVP launcher: sign in, pick a loadout, and launch Minecraft 1.8.9 with the VOID client mod.",
    "copyright": "Copyright (c) VOID"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://updates.void.invalid/pvp/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": false,
      "pubkey": "PLACEHOLDER_REPLACE_WITH_TAURI_SIGNING_PUBLIC_KEY"
    }
  }
}
